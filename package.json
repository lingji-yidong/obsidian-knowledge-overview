{
  "name": "obsidian-knowledge-overview",
  "version": "0.0.8",
  "description": "Generate structured subject overviews using AI.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "release:verify": "node verify-release.mjs",
    "test": "node tests/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "llm",
    "study-notes",
    "interview-prep"
  ],
  "author": "obafgkm42",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obafgkm42/obsidian-knowledge-overview.git"
  },
  "homepage": "https://github.com/obafgkm42/obsidian-knowledge-overview#readme",
  "bugs": {
    "url": "https://github.com/obafgkm42/obsidian-knowledge-overview/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "typescript": "^5.0.0"
  }
}
