    "obsidian",
    "obsidian-plugin",
    "llm",
    "study-notes",
    "interview-prep"
  ],
  "author": "obafgkm42",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obafgkm42/obsidian-knowledge-overview.git"
  },
  "homepage": "https://github.com/obafgkm42/obsidian-knowledge-overview#readme",
  "bugs": {
    "url": "https://github.com/obafgkm42/obsidian-knowledge-overview/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1"
  }
