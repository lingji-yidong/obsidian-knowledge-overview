# Copy this file to .env.eval.local. The local file is gitignored.
# This provider/model generates the chapters under test; it never evaluates them.
EVAL_API_BASE_URL=
EVAL_API_KEY=
EVAL_MODEL=

# Safe defaults: the smoke profile is 4 independent chapter calls.
EVAL_MAX_LOGICAL_REQUESTS=4
EVAL_MAX_PHYSICAL_REQUESTS=6
EVAL_MAX_COMPLETION_TOKENS=14000
EVAL_MAX_TOTAL_TOKENS=80000
EVAL_CONCURRENCY=1
EVAL_REQUEST_TIMEOUT_MS=300000
# Leave unsupported provider-specific fields blank to avoid a compatibility retry.
EVAL_TEMPERATURE=
EVAL_REASONING_EFFORT=
EVAL_VERBOSITY=
# auto omits the provider-specific toggle and supports always-thinking models.
# Use disabled only when the tested provider documents that it is supported.
EVAL_THINKING_MODE=auto

# Optional. When all three are set, the runner also enforces a USD ceiling.
EVAL_INPUT_USD_PER_MILLION=
EVAL_OUTPUT_USD_PER_MILLION=
EVAL_MAX_USD=
